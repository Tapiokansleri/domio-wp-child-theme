{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "domio/trustmary",
	"version": "1.1.0",
	"title": "Domio: Trustmary",
	"category": "domio",
	"icon": "star-filled",
	"description": "Näyttää Trustmary-arvostelut: sivun tekstinä tai Trustmary-widgettinä.",
	"keywords": [ "trustmary", "arvostelut", "referenssit", "domio" ],
	"textdomain": "domio",
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		},
		"widgetSrc": {
			"type": "string",
			"default": "https://widget.trustmary.com/n3eIUlhS5"
		},
		"mode": {
			"type": "string",
			"default": "widget"
		},
		"heading": {
			"type": "string",
			"default": "Asiakkaidemme kokemuksia"
		},
		"limit": {
			"type": "number",
			"default": 6
		},
		"order": {
			"type": "string",
			"default": "latest"
		},
		"showSummary": {
			"type": "boolean",
			"default": true
		},
		"background": {
			"type": "string",
			"default": "surface"
		},
		"pattern": {
			"type": "string",
			"default": "none"
		},
		"patternOpacity": {
			"type": "number",
			"default": 3
		}
	},
	"supports": {
		"align": [ "wide", "full" ],
		"anchor": true,
		"html": false,
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"example": {
		"attributes": {}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
