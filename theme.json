{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"custom": true,
			"link": true,
			"palette": [
				{
					"slug": "domio-primary",
					"color": "#121212",
					"name": "Domio Primary"
				},
				{
					"slug": "domio-primary-dark",
					"color": "#121212",
					"name": "Domio Primary Dark"
				},
				{
					"slug": "domio-accent",
					"color": "#04E78D",
					"name": "Domio Accent"
				},
				{
					"slug": "domio-ink",
					"color": "#121212",
					"name": "Domio Ink"
				},
				{
					"slug": "domio-muted",
					"color": "#777777",
					"name": "Domio Muted"
				},
				{
					"slug": "domio-surface",
					"color": "#ffffff",
					"name": "Domio Surface"
				}
			]
		},
		"layout": {
			"contentSize": "1300px",
			"wideSize": "100%"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "20",
					"size": "clamp(0.75rem, 0.6rem + 0.5vw, 1rem)",
					"name": "20"
				},
				{
					"slug": "30",
					"size": "clamp(1rem, 0.85rem + 0.6vw, 1.25rem)",
					"name": "30"
				},
				{
					"slug": "40",
					"size": "clamp(1.25rem, 1rem + 0.9vw, 1.75rem)",
					"name": "40"
				},
				{
					"slug": "50",
					"size": "clamp(1.75rem, 1.35rem + 1.4vw, 2.5rem)",
					"name": "50"
				},
				{
					"slug": "60",
					"size": "clamp(2.25rem, 1.7rem + 2vw, 3.5rem)",
					"name": "60"
				},
				{
					"slug": "70",
					"size": "clamp(3rem, 2.2rem + 2.8vw, 4.5rem)",
					"name": "70"
				},
				{
					"slug": "80",
					"size": "clamp(3.75rem, 2.75rem + 3.5vw, 6rem)",
					"name": "80"
				}
			],
			"units": [ "%", "px", "em", "rem", "vh", "vw" ]
		},
		"typography": {
			"fluid": true,
			"customFontSize": true,
			"lineHeight": true,
			"fontFamilies": [
				{
					"fontFamily": "\"Onest\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"name": "Onest",
					"slug": "onest"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "clamp(0.875rem, 0.85rem + 0.15vw, 0.9375rem)",
					"name": "Small"
				},
				{
					"slug": "medium",
					"size": "clamp(1rem, 0.95rem + 0.25vw, 1.125rem)",
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem)",
					"name": "Large"
				},
				{
					"slug": "x-large",
					"size": "clamp(1.75rem, 1.4rem + 1.2vw, 2.25rem)",
					"name": "Extra Large"
				},
				{
					"slug": "xx-large",
					"size": "clamp(2.25rem, 1.6rem + 2.8vw, 3.5rem)",
					"name": "XX Large"
				}
			]
		}
	},
	"styles": {
		"blocks": {
			"domio/trust-bar": {
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "0"
					}
				}
			},
			"domio/card-grid": {
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|60",
						"bottom": "var:preset|spacing|60"
					}
				}
			},
			"domio/media-text": {
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|60",
						"bottom": "var:preset|spacing|60"
					}
				}
			},
			"domio/steps": {
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|60",
						"bottom": "var:preset|spacing|60"
					}
				}
			},
			"domio/faq": {
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|60",
						"bottom": "var:preset|spacing|60"
					}
				}
			},
			"domio/related-links": {
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|60",
						"bottom": "var:preset|spacing|60"
					}
				}
			},
			"domio/hintalaskuri": {
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|60",
						"bottom": "var:preset|spacing|60"
					}
				}
			},
			"domio/trustmary": {
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|60",
						"bottom": "var:preset|spacing|60"
					}
				}
			},
			"domio/cta": {
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|80",
						"bottom": "var:preset|spacing|80"
					}
				}
			},
			"domio/contacts": {
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|60",
						"bottom": "var:preset|spacing|60"
					}
				}
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--onest)"
		},
		"color": {
			"background": "var(--wp--preset--color--domio-surface)",
			"text": "var(--wp--preset--color--domio-ink)"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--domio-ink)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--domio-ink)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--domio-accent)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--domio-accent)",
					"text": "var(--wp--preset--color--domio-ink)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--domio-accent)",
						"text": "var(--wp--preset--color--domio-ink)"
					}
				}
			}
		}
	}
}
